# ---------------------------------------------------------------------------
# Flatmarket environment configuration
# Copy to `.env` for local development. Never commit real secrets.
# Every optional integration degrades to an honest "not configured" state.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://flatmarket:flatmarket_dev@localhost:5432/flatmarket?schema=public"

# Public base URL of the site, used in share links, emails and PDFs (no trailing slash).
APP_URL="http://localhost:3000"

# Long random secret (min. 32 chars) used to sign form tokens and hash IP addresses.
# Generate with: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# --- File storage ------------------------------------------------------------
# "local" stores files on disk in STORAGE_LOCAL_DIR (fine for a single VPS with backups).
# "s3" stores files in any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2...).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Required only when STORAGE_DRIVER="s3". The bucket must be PRIVATE.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# --- AI text generation (optional) -----------------------------------------
# Without a key, listing descriptions are written manually (fully supported).
ANTHROPIC_API_KEY=""
# Any current Claude model id. Default: claude-opus-5-5
AI_TEXT_MODEL="claude-opus-5-5"
# low | medium | high
AI_TEXT_EFFORT="medium"
# "on" lets the API re-run a request on Anthropic's recommended fallback model
# if the primary model declines it. Set "off" to disable.
AI_TEXT_FALLBACKS="on"

# --- Photo enhancement (optional) ------------------------------------------
# The built-in "basic correction" (levels, white balance, light sharpening) always works.
# Claid.ai adds professional light/HDR correction. Get a key at https://claid.ai
CLAID_API_KEY=""
# Claid HDR intensity 0-100 (moderate values keep photos realistic).
CLAID_HDR_INTENSITY="60"

# --- Email (optional) --------------------------------------------------------
# Without email, enquiries and contact requests are still stored and visible
# in the dashboard / admin workspace, and the UI says that no email was sent.
EMAIL_PROVIDER=""          # "resend" or empty
RESEND_API_KEY=""
EMAIL_FROM=""              # e.g. "Flatmarket <noreply@yourdomain.gr>" (verified domain)
# Where contact/demo requests from the public site are delivered.
CONTACT_INBOX_EMAIL=""

# --- Accounts ----------------------------------------------------------------
# Comma-separated emails that are promoted to administrator when they sign up or log in.
ADMIN_EMAILS=""
# "open" lets anyone create an account; "closed" disables public sign-up
# (accounts can then only be created with `npm run user:create`).
SIGNUP_MODE="open"

# Set to "true" only when running behind a reverse proxy you control
# (Caddy, Nginx, Vercel) so X-Forwarded-For is trusted for rate limiting.
TRUST_PROXY="false"
